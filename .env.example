# Copy to .env and fill in real values. Never commit .env.

# ---- Telegram ----
# Get this from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=replace_with_token_from_botfather
# Optional: restrict bot to your own Telegram user id (get from @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=

# ---- LLM ----
# Local Ollama (default when running docker-compose)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Embedding model — used by ChromaDB semantic store. ~270MB, pull with: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
# Optional OpenAI fallback for complex reasoning
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=karnapassword

# ---- ChromaDB ----
# Default "embedded" = in-process, writes to data_local/chroma/. No daemon, no docker.
# Set to "http" if you want to point at a remote Chroma server.
CHROMA_MODE=embedded
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ---- Storage paths ----
KARNA_DATA_DIR=./data_local
KARNA_SQLITE_PATH=./data_local/karna.db

# ---- Logging ----
LOG_LEVEL=INFO
